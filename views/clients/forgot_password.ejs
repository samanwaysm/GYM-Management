<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dark Theme Login</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome for eye icon -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link rel="shortcut icon" href="/client/img/fevicon/fevicon.png" />

    <style>
        body {
            background: url('/client/img/hero-slider/hero-2.jpg') no-repeat center center/cover;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            background: rgba(0, 0, 0, 0.85);
            padding: 2rem;
            border-radius: 12px;
            width: 100%;
            max-width: 400px;
            color: #fff;
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.7);
        }

        .btn-custom {
            background-color: rgb(228, 56, 28);
            border: none;
        }

        .btn-custom:hover {
            background-color: rgb(200, 40, 15);
        }

        .form-control {
            background: #222;
            color: #fff;
            border: 1px solid #444;
        }

        .form-control:focus {
            background: #333;
            color: #fff;
            border-color: rgb(228, 56, 28);
            box-shadow: 0 0 0 0.2rem rgba(228, 56, 28, 0.25);
        }

        .forgot-link {
            color: rgb(228, 56, 28);
            text-decoration: none;
        }

        .forgot-link:hover {
            text-decoration: underline;
        }

        .input-group-text {
            background: #222;
            border: 1px solid #444;
            cursor: pointer;
        }

        .input-group-text i {
            color: #aaa;
        }
    </style>
</head>

<body>
    <div class="login-container">
        <h2 class="text-center mb-4">Forgot Password</h2>
        <% if (!showOtp) { %>
            <form method="POST" action="/admin/forgot-send-otp">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" placeholder="Enter email">
                    <% if (errors && errors.email) { %>
                        <div class="text-danger small">
                            <%= errors.email %>
                        </div>
                        <% } %>
                </div>
                <button type="submit" class="btn btn-custom text-white w-100">Send OTP</button>
            </form>
            <% } %>
                <% if (showOtp) { %>
                    <div class="container mt-4" style="max-width: 400px;">
                        <h5 class="text-center mb-3">Enter OTP</h5>
                        <form method="POST" action="/admin/forgot-verify-otp/<%= emailOtp %>">
                            <div class="d-flex justify-content-between">
                                <% for (let i=0; i < 6; i++) { %>
                                    <input type="tel" name="otp[]" maxlength="1" pattern="[0-9]*" inputmode="numeric"
                                        class="form-control text-center fs-4 otp-input"
                                        style="width: 50px; height: 50px;" required>
                                    <% } %>
                            </div>

                            <% if (errors && errors.otp) { %>
                                <div class="text-danger small mt-2">
                                    <%= errors.otp %>
                                </div>
                                <% } %>

                                    <div class="d-flex justify-content-between mt-3">
                                        <button type="submit" class="btn btn-success">Verify</button>
                                        <a href="/admin/forgot-resend-otp" class="btn btn-warning">Resend
                                            OTP</a>
                                    </div>
                        </form>
                    </div>

                    <script>
                        // Auto move to next input
                        document.querySelectorAll('.otp-input').forEach((input, index, inputs) => {
                            input.addEventListener('input', () => {
                                if (input.value.length === 1 && index < inputs.length - 1) {
                                    inputs[index + 1].focus();
                                }
                            });
                            input.addEventListener('keydown', (e) => {
                                if (e.key === "Backspace" && index > 0 && input.value === "") {
                                    inputs[index - 1].focus();
                                }
                            });
                        });
                    </script>
                    <% } %>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("password");
            const toggleEye = document.getElementById("toggleEye");
            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                toggleEye.classList.remove("fa-eye");
                toggleEye.classList.add("fa-eye-slash");
            } else {
                passwordInput.type = "password";
                toggleEye.classList.remove("fa-eye-slash");
                toggleEye.classList.add("fa-eye");
            }
        }
    </script>
</body>

</html>