<%-include("../admin/includes/header")-%>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="row">
              <!-- Branches -->
              <div class="col-sm-4 grid-margin">
                <div class="card">
                  <div class="card-body">
                    <h5>Branches</h5>
                    <div class="row">
                      <div class="col-8 col-sm-12 col-xl-8 my-auto">
                        <div class="d-flex d-sm-block d-md-flex align-items-center">
                          <h2 class="mb-0" id="branchesCount">0</h2>
                        </div>
                        <h6 class="text-muted font-weight-normal">Total registered branches</h6>
                      </div>
                      <div class="col-4 col-sm-12 col-xl-4 text-center text-xl-right">
                        <i class="icon-lg mdi mdi-domain text-primary ml-auto"></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Trainers -->
              <div class="col-sm-4 grid-margin">
                <div class="card">
                  <div class="card-body">
                    <h5>Trainers</h5>
                    <div class="row">
                      <div class="col-8 col-sm-12 col-xl-8 my-auto">
                        <div class="d-flex d-sm-block d-md-flex align-items-center">
                          <h2 class="mb-0" id="trainersCount">0</h2>
                        </div>
                        <h6 class="text-muted font-weight-normal">Total registered trainers</h6>
                      </div>
                      <div class="col-4 col-sm-12 col-xl-4 text-center text-xl-right">
                        <i class="icon-lg mdi mdi-account-tie text-success ml-auto"></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Clients -->
              <div class="col-sm-4 grid-margin">
                <div class="card">
                  <div class="card-body">
                    <h5>Clients</h5>
                    <div class="row">
                      <div class="col-8 col-sm-12 col-xl-8 my-auto">
                        <div class="d-flex d-sm-block d-md-flex align-items-center">
                          <h2 class="mb-0" id="clientsCount">0</h2>
                        </div>
                        <h6 class="text-muted font-weight-normal">Total registered clients</h6>
                      </div>
                      <div class="col-4 col-sm-12 col-xl-4 text-center text-xl-right">
                        <i class="icon-lg mdi mdi-account-group text-danger ml-auto"></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="row mt-5">
  <div class="col-lg-12 grid-margin stretch-card">
    <div class="card futuristic-card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="card-title futuristic-title">💳 Payment Analytics</h3>
          <button class="btn btn-success futuristic-btn" id="downloadExcel">
            <i class="mdi mdi-file-excel"></i> Download Excel
          </button>
        </div>

        <!-- Filters -->
        <div class="row mb-4">
          <div class="col-md-6">
            <select id="paymentMethodFilter" class="form-control futuristic-select">
              <option value="">All Methods</option>
              <option value="Cash">Cash</option>
              <option value="Online">Online</option>
            </select>
          </div>
          <div class="col-md-6">
            <select id="periodFilter" class="form-control futuristic-select">
              <option value="monthly">Monthly</option>
              <option value="yearly">Yearly</option>
            </select>
          </div>
        </div>

        <!-- Chart Container -->
        <div class="chart-container">
          <canvas id="paymentChart" height="120"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>
          </div>
        </div>
        
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
     <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
     <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
     <script>
        fetch("/admin/dashboard-counts")
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              document.getElementById("branchesCount").textContent = data.data.branches;
              document.getElementById("trainersCount").textContent = data.data.trainers;
              document.getElementById("clientsCount").textContent = data.data.clients;
            }
          })
          .catch(err => console.error("Error fetching counts:", err));

          fetch("/admin/dashboard-counts")
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        document.getElementById("branchesCount").textContent = data.data.branches;
        document.getElementById("trainersCount").textContent = data.data.trainers;
        document.getElementById("clientsCount").textContent = data.data.clients;
      }
    })
    .catch(err => console.error("Error fetching counts:", err));

  let paymentChart;

  async function fetchPaymentStats() {
    const method = document.getElementById("paymentMethodFilter").value;
    const period = document.getElementById("periodFilter").value;

    try {
      const res = await fetch(`/admin/payment-stats?method=${method}&period=${period}`);
      const data = await res.json();

      if (!data.success) return console.error("Failed to fetch stats");

      const stats = data.data;
      const labels =
        period === "yearly"
          ? stats.map(s => s._id.year)
          : stats.map(s => `${s._id.month}/${s._id.year}`);

      const values = stats.map(s => s.totalAmount);

      const ctx = document.getElementById("paymentChart").getContext("2d");
      if (paymentChart) paymentChart.destroy();

      paymentChart = new Chart(ctx, {
        type: "bar",
        data: {
          labels,
          datasets: [
            {
              label: "Total Payment Amount (INR)",
              data: values,
              backgroundColor: "rgba(78, 115, 223, 0.8)",
              borderRadius: 8,
            },
          ],
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: true, position: "bottom" },
            tooltip: { enabled: true },
          },
          scales: {
            y: { beginAtZero: true, ticks: { precision: 0 } },
          },
        },
      });
    } catch (err) {
      console.error("Error fetching stats:", err);
    }
  }

  // 🎯 Automatically fetch when filters change
  document.getElementById("paymentMethodFilter").addEventListener("change", fetchPaymentStats);
  document.getElementById("periodFilter").addEventListener("change", fetchPaymentStats);

  // 💾 Download Excel
  document.getElementById("downloadExcel").addEventListener("click", () => {
    const method = document.getElementById("paymentMethodFilter").value;
    window.location.href = `/admin/download-payments${method ? `?method=${method}` : ""}`;
  });

  // 🚀 Initial Load
  fetchPaymentStats();
     </script>
    <!-- plugins:js -->
    <script src="/admin/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="/admin/vendors/chart.js/Chart.min.js"></script>
    <script src="/admin/vendors/progressbar.js/progressbar.min.js"></script>
    <script src="/admin/vendors/jvectormap/jquery-jvectormap.min.js"></script>
    <script src="/admin/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
    <script src="/admin/vendors/owl-carousel-2/owl.carousel.min.js"></script>
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/admin/js/off-canvas.js"></script>
    <script src="/admin/js/hoverable-collapse.js"></script>
    <script src="/admin/js/misc.js"></script>
    <script src="/admin/js/settings.js"></script>
    <script src="/admin/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="/admin/js/dashboard.js"></script>
    <!-- End custom js for this page -->
  </body>
</html>