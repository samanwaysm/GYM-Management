  async function fetchPaymentStats() {
    const method = document.getElementById("paymentMethodFilter").value;
    const period = document.getElementById("periodFilter").value;

    const res = await fetch(`/admin/payment-stats?period=${period}`);
    const data = await res.json();

    if (!data.success) return console.error("Error fetching data");

    const stats = data.data;

    // Separate data by method
    const allPayments = await fetchAllMethods(period);

    // Labels and data
    const labels = allPayments.labels;
    const cashValues = allPayments.cash;
    const onlineValues = allPayments.online;

    const ctx = document.getElementById("paymentChart").getContext("2d");

    // Create gradient fill
    const gradientBar = ctx.createLinearGradient(0, 0, 0, 400);
    gradientBar.addColorStop(0, "rgba(0, 255, 255, 0.8)");
    gradientBar.addColorStop(1, "rgba(0, 255, 255, 0.1)");

    const gradientLine = ctx.createLinearGradient(0, 0, 0, 400);
    gradientLine.addColorStop(0, "rgba(255, 99, 132, 0.8)");
    gradientLine.addColorStop(1, "rgba(255, 99, 132, 0.1)");

    if (paymentChart) paymentChart.destroy();

    paymentChart = new Chart(ctx, {
      type: "bar",
      data: {
        labels,
        datasets: [
          {
            label: "Cash Payments",
            data: cashValues,
            backgroundColor: gradientBar,
            borderColor: "#00ffff",
            borderWidth: 1.5,
            borderRadius: 10,
          },
          {
            label: "Online Payments",
            data: onlineValues,
            type: "line",
            borderColor: "#ff6384",
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: "#ff6384",
            pointRadius: 5,
            pointHoverRadius: 7,
          },
        ],
      },
      options: {
        responsive: true,
        animation: {
          duration: 1200,
          easing: "easeInOutQuart",
        },
        plugins: {
          legend: {
            labels: { color: "#00ffff" },
          },
          tooltip: {
            backgroundColor: "#111",
            borderColor: "#00ffff",
            borderWidth: 1,
            titleColor: "#00ffff",
            bodyColor: "#fff",
          },
        },
        scales: {
          x: {
            ticks: { color: "#00ffff" },
            grid: { color: "rgba(0,255,255,0.1)" },
          },
          y: {
            ticks: { color: "#00ffff" },
            grid: { color: "rgba(0,255,255,0.1)" },
          },
        },
      },
    });
  }

  async function fetchAllMethods(period) {
    const cashRes = await fetch(`/admin/payment-stats?method=Cash&period=${period}`);
    const onlineRes = await fetch(`/admin/payment-stats?method=Online&period=${period}`);
    const cashData = (await cashRes.json()).data;
    const onlineData = (await onlineRes.json()).data;

    // Extract unique labels
    const allLabels = new Set();
    cashData.forEach(d => {
      allLabels.add(period === "yearly" ? d._id.year : `${d._id.month}/${d._id.year}`);
    });
    onlineData.forEach(d => {
      allLabels.add(period === "yearly" ? d._id.year : `${d._id.month}/${d._id.year}`);
    });
    const labels = Array.from(allLabels).sort();

    // Map data
    const cashMap = Object.fromEntries(cashData.map(d => [
      period === "yearly" ? d._id.year : `${d._id.month}/${d._id.year}`,
      d.totalAmount
    ]));
    const onlineMap = Object.fromEntries(onlineData.map(d => [
      period === "yearly" ? d._id.year : `${d._id.month}/${d._id.year}`,
      d.totalAmount
    ]));

    const cash = labels.map(l => cashMap[l] || 0);
    const online = labels.map(l => onlineMap[l] || 0);

    return { labels, cash, online };
  }

  // Filters
  document.getElementById("applyFilter").addEventListener("click", fetchPaymentStats);
  document.getElementById("downloadExcel").addEventListener("click", () => {
    window.location.href = "/admin/download-payments";
  });

  // Initial load
  fetchPaymentStats();
