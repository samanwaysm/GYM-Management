<%-include("../admin/includes/header")-%>
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Clients List </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#"> Clients </a></li>
                                <li class="breadcrumb-item active" aria-current="page">Clients List</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="mt-3 mb-3 d-flex justify-content-between">
                        <a href="/admin-add-clients"><button type="button" class="btn btn-primary btn-md">
                                <i class="mdi mdi-account"></i> Add Clients </button></a>
                        <!-- <a href="/admin-"><button type="button" class="btn btn-primary btn-md">
                                <i class="mdi mdi-account"></i> Not Active Clients </button></a> -->
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <!-- Search Box -->
                            <div class="mb-3 d-flex" style="gap: 1rem;">
                                <input type="text" id="searchBox" class="form-control text-white w-75"
                                    placeholder="Search client (name, email, phone...)">
                                <select id="branchFilter" class="form-control text-white w-25">
                                    <option value="">-- Select Branch --</option>
                                </select>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Phone</th>
                                            <th>Branch</th>
                                            <th>Trainer</th>                                            
                                            <th>Expiry Date</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="clientsTableBody">
                                        <!-- Data inserted dynamically -->
                                    </tbody>
                                </table>


                            </div>
                        </div>

                    </div>
                    <!-- Pagination -->
                    <nav class="d-flex justify-content-center mt-3">
                        <ul class="pagination" id="pagination">
                            <!-- Pagination buttons will be added dynamically -->
                        </ul>
                    </nav>
                </div>
                <!-- content-wrapper ends -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/admin/logics/clients_list.js"></script>
<%-include("../admin/includes/footer")-%>