                <script>
                    let currentPage = 1;

                    function loadPayments(page = 1, search = "") {
                        fetch(`/admin/payments-list?page=${page}&search=${encodeURIComponent(search)}`)
                            .then(res => res.json())
                            .then(result => {
                                if (result.success) {
                                    const tbody = document.getElementById("paymentTableBody");
                                    const pagination = document.getElementById("pagination");
                                    tbody.innerHTML = "";

                                    function formatDate(dateStr) {
                                        if (!dateStr) return "-";

                                        const date = new Date(dateStr);
                                        return date.toLocaleString("en-IN", {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric",
                                            hour: "2-digit",
                                            minute: "2-digit",
                                            hour12: true
                                        });
                                    }

                                    // Render rows
                                    result.data.forEach(payment => {
                                        const row = `
                                            <tr>
                                                <td>${payment.user || "N/A"}</td>
                                                <td>${payment.phone || "N/A"}</td>
                                                <td>₹${payment.amount}</td>
                                                <td>${payment.method}</td>
                                                <td>${formatDate(payment.paymentDate)}</td>
                                                <td>
                                                    <span class="badge ${
                                                    payment.status === "Completed"
                                                        ? "badge-success"
                                                        : payment.status === "Pending"
                                                        ? "badge-warning"
                                                        : "badge-danger"
                                                    }">${payment.status}</span>
                                                </td>
                                                <td>${payment.paymentId}</td>
                                            </tr>
                                        `;
                                        tbody.insertAdjacentHTML("beforeend", row);
                                    });

                                    // Render pagination
                                    pagination.innerHTML = "";
                                    for (let i = 1; i <= result.pagination.totalPages; i++) {
                                        pagination.innerHTML += `
                                            <li class="page-item ${i === result.pagination.page ? "active" : ""}">
                                                <a class="page-link" href="javascript:void(0)" onclick="changePage(${i})">${i}</a>
                                            </li>
                                        `;
                                    }
                                }
                            })
                            .catch(err => console.error("Error:", err));
                    }

                    function changePage(page) {
                        currentPage = page;
                        const search = document.getElementById("searchBox").value;
                        loadPayments(currentPage, search);
                    }

                    // Search live filter
                    document.getElementById("searchBox").addEventListener("input", function () {
                        currentPage = 1; // reset to first page on search
                        loadPayments(currentPage, this.value);
                    });

                    // Initial load
                    document.addEventListener("DOMContentLoaded", function () {
                        loadPayments();
                    });
                    </script>


