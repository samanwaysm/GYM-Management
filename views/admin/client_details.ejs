<%-include("../admin/includes/header")-%>

    <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Client Details </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#"> Clients </a></li>
                                <li class="breadcrumb-item active" aria-current="page">Client Details</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="mt-3 mb-3 d-flex justify-content-between">
                        <!-- <a href="/admin-add-clients"><button type="button" class="btn btn-primary btn-md">
                                <i class="mdi mdi-account"></i> Add Clients </button></a> -->
                        <!-- <a href="/admin-"><button type="button" class="btn btn-primary btn-md">
                                <i class="mdi mdi-account"></i> Not Active Clients </button></a> -->
                    </div>
                    <div class="card shadow-lg p-4 mb-4" style="width: 100%; max-width: 1200px; margin: auto;">
                    <!-- Client Image -->
                    <div class="text-center mb-4">
                        <h4 class="mt-3 fw-bold">Client Details</h4>
                        <img id="clientImage"
                            alt="Client Image"
                            class="rounded-circle shadow"
                            style="width: 150px; height: 150px; object-fit: cover;">
                    </div>

                    <!-- Membership Info -->
                    <div class="mb-4 p-3 border rounded">
                        <h6 class="fw-bold mb-3 text-center">Membership Details</h6>
                        <div class="d-flex mb-3 fs-5"><div class="w-25"><strong>Package:</strong></div><div id="package"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-25"><strong>Expiry Date:</strong></div><div id="expiryDate"></div></div>
                        <div class="d-flex mb-0 fs-5"><div class="w-25"><strong>Status:</strong></div><div id="status"></div></div>
                    </div>

                    <div class="row">
                        <!-- Left Column -->
                        <div class="col-md-6 mb-3">
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Name:</strong></div><div id="name"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Email:</strong></div><div id="email"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Phone:</strong></div><div id="phone"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Alt Phone:</strong></div><div id="altPhone"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Gender:</strong></div><div id="gender"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Age:</strong></div><div id="age"></div></div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6 mb-3">
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Branch:</strong></div><div id="branch"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Trainer:</strong></div><div id="trainer"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Height:</strong></div><div id="height"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Weight:</strong></div><div id="weight"></div></div>
                        <div class="d-flex mb-3 fs-5"><div class="w-50"><strong>Joined Date:</strong></div><div id="joinedDate"></div></div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center mt-4">
                    <a id="editBtn" href="#" class="btn btn-lg btn-primary me-3 px-4">
                        Edit <i class="mdi mdi-file-check btn-icon-append"></i>
                    </a>
                    <button id="deleteBtn" class="btn btn-lg btn-danger px-4">
                        Delete <i class="mdi mdi-delete btn-icon-prepend"></i>
                    </button>
                    </div>


                    <!-- Pagination -->
                    <nav class="d-flex justify-content-center mt-3">
                        <ul class="pagination" id="pagination">
                            <!-- Pagination buttons will be added dynamically -->
                        </ul>
                    </nav>
                </div>
                <!-- content-wrapper ends -->

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
  document.addEventListener("DOMContentLoaded", function () {
    const pathParts = window.location.pathname.split("/");
    const clientId = pathParts[pathParts.length - 1]; // last part = id

    if (clientId) {
      fetchClientDetails(clientId);
    }
  });

    function calculateAge(dob) {
    const today = new Date();
    const birthDate = new Date(dob);
    let age = today.getFullYear() - birthDate.getFullYear();
    const m = today.getMonth() - birthDate.getMonth();

    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
      age--;
    }
    return age;
  }


  async function fetchClientDetails(clientId) {
    try {
      const res = await fetch(`/admin/get-client-details/${clientId}`);
      const result = await res.json();

      if (result.success) {
        const c = result.data;
        // ✅ Client Image
        document.getElementById("clientImage").src = c.img || "/admin/images/noProfile/profile.png";

        // ✅ Membership Details
        document.getElementById("package").textContent = c.membership?.packageType || "-";
        document.getElementById("expiryDate").textContent = c.membership?.expiredDate 
            ? new Date(c.membership.expiredDate).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }) 
            : "-";

        document.getElementById("status").innerHTML =
            `<span class="badge ${c.membership?.status === "Active" ? "bg-success" : "bg-danger"} fs-6">
                ${c.membership?.status || "-"}
            </span>`;

        document.getElementById("name").textContent = c.name;
        document.getElementById("email").textContent = c.email;
        document.getElementById("phone").textContent = c.phone;
        document.getElementById("altPhone").textContent = c.altPhone || '-';
        document.getElementById("gender").textContent = c.gender;
        document.getElementById("age").textContent = calculateAge(c.dob);
        document.getElementById("branch").textContent = c.branch;
        document.getElementById("trainer").textContent = c.trainer;
        document.getElementById("height").textContent = c.height;
        document.getElementById("weight").textContent = c.weight;
        document.getElementById("joinedDate").textContent = c.joinedDate 
            ? new Date(c.joinedDate).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }) 
            : "-";
        // Set Edit button link dynamically
        document.getElementById("editBtn").href = `/admin-edit-clients/${c.clientId}`;

        // Set Delete button event
        document.getElementById("deleteBtn").onclick = function () {
        confirmDelete(c.clientId);
        };
      }
    } catch (error) {
      console.error("Error fetching client:", error);
    }
  }

  async function confirmDelete(clientId) {
  if (!confirm("⚠️ Are you sure you want to permanently delete this Client?")) return;

  try {
    const res = await fetch(`/admin/delete-clients/${clientId}`, {
      method: "DELETE",
      headers: { "Content-Type": "application/json" }
    });

    const result = await res.json();

    if (result.success) {
      alert("✅ Client deleted successfully!");
      window.location.href = "/admin-clients-list"; // redirect to list
    } else {
      alert("❌ " + (result.error || "Failed to delete client"));
    }
  } catch (err) {
    console.error("❌ Error deleting client:", err);
    alert("⚠️ Server error, please try again later");
  }
}

</script>
