                                                            <option value="Cash">Cash</option>
                                                            <option value="UPI">UPI</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-center mt-3">
                                            <button type="submit" class="btn btn-primary">Update Membership</button>
                                        </div>
                                    </form>

                                    <hr>

                                    <!-- ================= DETAILS FORM ================= -->
                                    <form id="detailsForm" class="form-sample">
