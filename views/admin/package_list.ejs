<%-include("../admin/includes/header")-%>
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Package List </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#"> Admin </a></li>
                                <li class="breadcrumb-item active" aria-current="page"> Package List </li>
                            </ol>
                        </nav>
                    </div>
                    <div class="mt-3 mb-3 d-flex justify-content-between">
                        <button type="button" class="btn btn-primary btn-md" data-toggle="modal"
                            data-target="#addPackageModal">
                            <i class="mdi mdi-account"></i> Add Package
                        </button>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Package Name</th>
                                            <th>Price</th>
                                            <th>Edit</th>
                                            <th>Delete</th>
                                        </tr>
                                    </thead>

                                    <tbody id="packageBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add Package Modal -->
                <div class="modal fade" id="addPackageModal" tabindex="-1" role="dialog"
                    aria-labelledby="addPackageModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Add Package</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span>&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <form id="addPackageForm">
                                    <div class="form-group">
                                        <label>Package Type</label>
                                        <input type="text" class="form-control text-white" id="packageType" name="packageType"
                                            required>
                                    </div>
                                    <div class="form-group">
                                        <label>Duration in Days</label>
                                        <input type="number" class="form-control text-white" id="durationInDays" name="durationInDays" required
                                            min="0">
                                    </div>
                                    <div class="form-group">
                                        <label>Price</label>
                                        <input type="number" class="form-control text-white" id="price" name="price" required
                                            min="0">
                                    </div>
                                    <button type="submit" class="btn btn-primary">Save Package</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- content-wrapper ends -->
                

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/admin/logics/package_list.js"></script>

<%-include("../admin/includes/footer")-%>