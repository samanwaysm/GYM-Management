<%-include("../admin/includes/header")-%>
      <!-- partial -->
      <div class="main-panel">
        <div class="content-wrapper">
          <div class="page-header">
            <h3 class="page-title"> Add Trainers </h3>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin-trainers-list"> Trainer </a></li>
                <li class="breadcrumb-item active" aria-current="page">Add Trainers</li>
              </ol>
            </nav>
          </div>
          <div class="row">
            <div class="col-12 grid-margin mt-5">
              <div class="card">
                <div class="card-body mt-3">
                  <!-- <h4 class="card-title">Horizontal Two column</h4> -->
                  <form class="form-sample" id="admin_register" method="POST" action="/admin/add-trainers">
                    <!-- <p class="card-description"> Personal info </p> -->
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Name : </label>
                          <div class="col-sm-9">
                            <input type="text" id="name" name="name" class="form-control text-white" />
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Email : </label>
                          <div class="col-sm-9">
                            <input type="email" id="email" name="email" class="form-control text-white" />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Phone Number : </label>
                          <div class="col-sm-9 d-flex align-items-center">
                            <!-- <span class="input-group-text">+91</span> -->
                            <input type="tel" id="phone" name="phone" class="form-control text-white" maxlength="10"
                              pattern="[0-9]{10}" oninput="this.value=this.value.replace(/[^0-9]/g,'')" required />
                          </div>
                          <% if (errors && errors.phoneError) { %>
                            <div class="text-danger small mt-1">
                              <%= errors.phoneError %>
                            </div>
                          <% } %>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Branch : </label>
                          <div class="col-sm-9">
                            <select class="form-control text-white" name="branch" id="branch" required>
                              <option class="form-control text-white" value="">-- Select Branch --</option>
                            </select>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                    </div>
                    <div class="mt-2 text-right">
                      <button type="submit" class="btn btn-success mr-2 text-dark">Submit</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- content-wrapper ends -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/admin/logics/add_trainers.js"></script>
<%-include("../admin/includes/footer")-%>