<%-include("../admin/includes/header")-%>
      <!-- partial -->
      <div class="main-panel">
        <div class="content-wrapper">
          <div class="page-header">
            <h3 class="page-title"> Add Client </h3>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#"> Admin </a></li>
                <li class="breadcrumb-item active" aria-current="page">Add Client</li>
              </ol>
            </nav>
          </div>
          <div class="row">
            <div class="col-12 grid-margin mt-5">
              <div class="card">
                <div class="card-body mt-3">
                  <!-- <h4 class="card-title">Horizontal Two column</h4> -->
                  <form class="form-sample" id="admin_register" method="POST" action="/admin/add-clients"
                    enctype="multipart/form-data">
                    <!-- <p class="card-description"> Personal info </p> -->
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Name : </label>
                          <div class="col-sm-9">
                            <input type="text" id="name" name="name" class="form-control" />
                            <% if (errors && errors.name) { %>
                              <div class="text-danger small">
                                <%= errors.name %>
                              </div>
                              <% } %>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Email : </label>
                          <div class="col-sm-9">
                            <input type="email" id="email" name="email" class="form-control" />
                            <% if (errors && errors.email) { %>
                              <div class="text-danger small">
                                <%= errors.email %>
                              </div>
                              <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Phone Number : </label>
                          <div class="col-sm-9 d-flex align-items-center">
                            <!-- <span class="input-group-text">+91</span> -->
                            <input type="tel" id="phone" name="phone" class="form-control" maxlength="10"
                              pattern="[0-9]{10}" oninput="this.value=this.value.replace(/[^0-9]/g,'')" required />
                          </div>
                          <% if (errors && errors.phoneError) { %>
                            <div class="text-danger small mt-1">
                              <%= errors.phoneError %>
                            </div>
                            <% } %>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Alt.Phone : </label>
                          <div class="col-sm-9">
                            <input type="tel" id="altphone" name="altphone" class="form-control"
                              placeholder="(optional)" />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Gender : </label>
                          <div class="col-sm-9">
                            <select class="form-control" name="gender" id="gender" required>
                              <option class="form-control" value="">-- Select Gender --</option>
                              <option class="form-control" value="Male">Male</option>
                              <option class="form-control" value="Female">Female</option>
                              <option class="form-control" value="Other">Other</option>
                            </select>
                            <% if (errors && errors.gender) { %>
                              <div class="text-danger small">
                                <%= errors.gender %>
                              </div>
                              <% } %>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Age : </label>
                          <div class="col-sm-9">
                            <input type="number" id="age" name="age" class="form-control" />
                            <% if (errors && errors.age) { %>
                              <div class="text-danger small">
                                <%= errors.age %>
                              </div>
                              <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Branch : </label>
                          <div class="col-sm-9">
                            <select class="form-control" name="branch" id="branch" required>
                              <option class="form-control" value="">-- Select Branch --</option>
                            </select>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label"> Trainer : </label>
                          <div class="col-sm-9">
                            <select class="form-control" name="trainer" id="trainer" required>
                              <option class="form-control" value="">-- Select Trainer --</option>
                            </select>

                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Height : </label>
                          <div class="col-sm-9">
                            <input type="number" id="height" name="height" class="form-control" />
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Weight : </label>
                          <div class="col-sm-9">
                            <input type="text" id="weight" name="weight" class="form-control" />
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group row">
                          <label class="col-sm-3 col-form-label">Profile Image : </label>
                          <div class="col-sm-9">
                            <input type="file" id="img" name="img" class="form-control" accept="image/*"
                              onchange="previewImage(event)" />
                            <div class="mt-2">
                              <img id="imgPreview" src="" alt="Image Preview"
                                style="max-width: 150px; display: none; border: 1px solid #ccc; border-radius: 5px; padding: 3px;" />
                            </div>
                            <% if (errors && errors.profileImg) { %>
                              <div class="text-danger small">
                                <%= errors.profileImg %>
                              </div>
                              <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!-- hidden inputs to carry modal values -->
                    <input type="hidden" name="package" id="hiddenPackage">
                    <input type="hidden" name="paymentMethod" id="hiddenPaymentMethod">
                    <input type="hidden" id="hiddenConfirmedPayment" name="confirmedPayment">
                    <div class="text-center mt-2">
                      <button type="submit" class="btn btn-primary mr-2">Submit</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal fade" id="membershipModal" tabindex="-1" aria-labelledby="membershipModalLabel"
          aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">

              <div class="modal-header">
                <h5 class="modal-title" id="membershipModalLabel">Membership & Payment Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>

              <div class="modal-body">
                <div class="mb-3">
                  <label for="package" class="form-label">Package</label>
                  <select class="form-control" id="package" name="package" required>
                    <option value="">-- Select Package --</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="paymentMethod" class="form-label">Payment Method</label>
                  <select class="form-control" id="paymentMethod" name="paymentMethod" required>
                    <option value="">-- Select Payment Method --</option>
                    <option value="Cash">Cash</option>
                    <option value="UPI">UPI</option>
                  </select>
                </div>
              </div>

              <div class="modal-footer">
                <button type="button" id="confirmSave" class="btn btn-success">Save & Submit</button>
              </div>

            </div>
          </div>
        </div>
        <!-- content-wrapper ends -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/admin/logics/add_clients.js"></script>
<%-include("../admin/includes/footer")-%>