<%-include("../admin/includes/header")-%>
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Edit Trainers </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#"> Trainers </a></li>
                                <li class="breadcrumb-item active" aria-current="page">Edit Trainers</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="row">
                        <div class="col-12 grid-margin mt-5">
                            <div class="card">
                                <div class="card-body mt-3">
                                    <!-- <h4 class="card-title">Horizontal Two column</h4> -->
                                    <form class="form-sample" id="editTrainerForm">
                                        <!-- <p class="card-description"> Personal info </p> -->
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group row">
                                                    <label class="col-sm-3 col-form-label">Name : </label>
                                                    <div class="col-sm-9">
                                                        <input type="text" id="name" name="name" class="form-control" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group row">
                                                    <label class="col-sm-3 col-form-label">Email : </label>
                                                    <div class="col-sm-9">
                                                        <input type="email" id="email" name="email"
                                                            class="form-control" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group row">
                                                    <label class="col-sm-3 col-form-label">Phone Number : </label>
                                                    <div class="col-sm-9 d-flex align-items-center">
                                                        <!-- <span class="input-group-text">+91</span> -->
                                                        <input type="tel" id="phone" name="phone" class="form-control"
                                                            maxlength="10" pattern="[0-9]{10}"
                                                            oninput="this.value=this.value.replace(/[^0-9]/g,'')"
                                                            required />
                                                    </div>
                                                    <% if (errors && errors.phoneError) { %>
                                                        <div class="text-danger small mt-1">
                                                            <%= errors.phoneError %>
                                                        </div>
                                                        <% } %>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group row">
                                                    <label class="col-sm-3 col-form-label">Branch : </label>
                                                    <div class="col-sm-9">
                                                        <select class="form-control" name="branch" id="branch" required>
                                                            <option class="form-control" value="">-- Select Branch --
                                                            </option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                        </div>
                                        <div class="text-center mt-2">
                                            <button type="submit" class="btn btn-primary mr-2">Submit</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- content-wrapper ends -->
                
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/admin/logics/edit_trainer.js"></script>

    <%-include("../admin/includes/footer")-%>