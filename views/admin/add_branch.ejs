<%-include("../admin/includes/header")-%>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="page-header">
              <h3 class="page-title"> Add Branch </h3>
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="/admin-branches-list">Branch</a></li>
                  <li class="breadcrumb-item active" aria-current="page">Add Branch</li>
                </ol>
              </nav>
            </div>
            <div class="row">
              <div class="col-12 grid-margin mt-5">
                <div class="card">
                  <div class="card-body mt-3">
                    <!-- <h4 class="card-title">Horizontal Two column</h4> -->
                    <form class="form-sample" id="admin_register" method="POST" action="/admin/add-branch">
                      <!-- <p class="card-description"> Personal info </p> -->
                      <div class="row">
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Branch Name : </label>
                            <div class="col-sm-9">
                              <input type="text" id="name" name="name" class="form-control text-white" />
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Phone : </label>
                            <div class="col-sm-9 d-flex align-items-center">
                            <!-- <span class="input-group-text">+91</span> -->
                            <input type="tel" id="phone" name="phone" class="form-control text-white" maxlength="10"
                              pattern="[0-9]{10}" oninput="this.value=this.value.replace(/[^0-9]/g,'')" required />
                          </div>
                          </div>
                        </div>
                      </div>
                      <div class="row">
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label"> Address : </label>
                            <div class="col-sm-9">
                              <input type="text" id="address" name="address" class="form-control text-white" />
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">City : </label>
                            <div class="col-sm-9">
                              <input type="text" id="city" name="city" class="form-control text-white" />
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="row">
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">State : </label>
                            <div class="col-sm-9">
                              <input type="text" id="state" name="state" class="form-control text-white" />
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Pincode : </label>
                            <div class="col-sm-9">
                              <input type="number" id="pincode" name="pincode" class="form-control text-white" />
                            </div>
                          </div>
                        </div>
                      </div>
                      <!-- <div class="row">
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Lat : </label>
                            <div class="col-sm-9">
                              <input type="number" id="lat" name="lat" class="form-control" placeholder="(optional)"/>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Lng : </label>
                            <div class="col-sm-9">
                              <input type="number" id="lng" name="lng" class="form-control" placeholder="(optional)"/>
                            </div>
                          </div>
                        </div>
                      </div> -->
                      <div class="mt-2 text-right">
                        <button type="submit" class="btn btn-success mr-2 text-dark">Submit</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- content-wrapper ends -->
          <%-include("../admin/includes/footer")-%>