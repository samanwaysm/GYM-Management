<%-include("../admin/includes/header")-%>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="page-header">
              <h3 class="page-title"> Add Branch </h3>
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="/admin-branches-list">Branch</a></li>
                  <li class="breadcrumb-item active" aria-current="page">Add Branch</li>
                </ol>
              </nav>
            </div>
            <div class="row">
              <div class="col-12 grid-margin mt-5">
                <div class="card">
                  <div class="card-body mt-3">
                    <form id="branchForm" novalidate>
                      <div class="row">
                        <!-- Branch Name -->
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Branch Name :</label>
                            <div class="col-sm-9">
                              <input type="text" id="name" name="name" class="form-control text-white" required />
                              <div class="invalid-feedback" id="nameError"></div>
                            </div>
                          </div>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Phone :</label>
                            <div class="col-sm-9">
                              <input type="tel" id="phone" name="phone" class="form-control text-white" maxlength="10"
                                    pattern="[0-9]{10}" required
                                    oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                              <div class="invalid-feedback">Enter a valid 10-digit phone number.</div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="row">
                        <!-- Address -->
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Address :</label>
                            <div class="col-sm-9">
                              <input type="text" id="address" name="address" class="form-control text-white" required />
                              <div class="invalid-feedback">Address is required.</div>
                            </div>
                          </div>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">City :</label>
                            <div class="col-sm-9">
                              <input type="text" id="city" name="city" class="form-control text-white" required />
                              <div class="invalid-feedback">City is required.</div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="row">
                        <!-- State -->
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">State :</label>
                            <div class="col-sm-9">
                              <input type="text" id="state" name="state" class="form-control text-white" required />
                              <div class="invalid-feedback">State is required.</div>
                            </div>
                          </div>
                        </div>

                        <!-- Pincode -->
                        <div class="col-md-6">
                          <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Pincode :</label>
                            <div class="col-sm-9">
                              <input type="text" id="pincode" name="pincode" class="form-control text-white" pattern="[0-9]{6}" required />
                              <div class="invalid-feedback">Enter a valid 6-digit pincode.</div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="mt-2 text-right">
                        <button type="submit" class="btn btn-success mr-2 text-dark">Submit</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
          <script>
  const nameInput = document.getElementById("name");
  const errorDiv = document.getElementById("nameError");

  function showError(message) {
    nameInput.classList.add("is-invalid");
    errorDiv.textContent = message; // dynamically inject
  }

  function clearError() {
    nameInput.classList.remove("is-invalid");
    errorDiv.textContent = ""; // remove text completely
  }

  // Blur event
  nameInput.addEventListener("blur", async function () {
    const name = nameInput.value.trim();
    clearError();

    // Case 1: Empty field
    if (!name) {
      showError("Branch name is required.");
      return;
    }

    try {
      // Case 2: Duplicate check
      const res = await fetch(`/admin/check-branch?name=${encodeURIComponent(name)}`);
      const data = await res.json();

      if (data.exists) {
        showError("Branch name already exists.");
      }
    } catch (err) {
      console.error("Error checking branch:", err);
    }
  });

  // Submit event
  document.getElementById("branchForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    const form = e.target;

    if (!form.checkValidity()) {
      form.classList.add("was-validated");
      return;
    }

    const formData = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch("/admin/add-branch", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData)
      });

      const data = await res.json();

      if (data.success) {
        alert("✅ Branch added successfully!");
        form.reset();
        form.classList.remove("was-validated");
        clearError();
      } else {
        if (data.errors?.name) {
          showError(data.errors.name);
        }
      }
    } catch (err) {
      alert("❌ Server error. Please try again.");
    }
  });
</script>

